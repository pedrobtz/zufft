# zufft build flags: design §12.3. R CMD check warns about any -f, -m or -O
# flag in a PKG_*FLAGS variable and NOTEs non-portable flags in the install
# log; CI fails on either. Fused multiply-add contraction is requested in the
# source instead (zff_fp_contract.h).
CXX_STD = CXX17

# -I. finds the vendored ducc0/ tree and the custom threading header,
# -I../inst/include the public header the C table implements;
# custom threading lets zufft own the thread pool (design §6.5); -pthread
# where std::thread needs it (WRE §1.2.1 allows it in PKG_CPPFLAGS).
PKG_CPPFLAGS = -I. -I../inst/include -DDUCC0_CUSTOM_LOWLEVEL_THREADING -pthread

# Hidden symbols, the way R's own Makeconf spells them. ZUFFT_CXXFLAGS is
# an opt-in hook for a native build: make reads it from the environment
# (for example ZUFFT_CXXFLAGS=-march=native), and it is empty unless the
# user sets it, so CRAN builds and R CMD check see only $(CXX_VISIBILITY).
# Windows only: MinGW-w64 GCC does not align the stack to 32 bytes for AVX
# values (GCC bug 54412), so a native build crashes on aligned vector moves.
# When the user sets ZUFFT_CXXFLAGS, have the assembler emit unaligned moves
# instead. Makevars.win may use GNU make conditionals (WRE 1.2.1); unset,
# nothing is added.
ifneq ($(strip $(ZUFFT_CXXFLAGS)),)
ZUFFT_WIN_CXXFLAGS = -Wa,-muse-unaligned-vector-move
endif
PKG_CXXFLAGS = $(CXX_VISIBILITY) $(ZUFFT_CXXFLAGS) $(ZUFFT_WIN_CXXFLAGS)
PKG_CFLAGS = $(C_VISIBILITY)
PKG_LIBS = -pthread
